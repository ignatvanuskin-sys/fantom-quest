# Fantom — переменные окружения
#
# Скопируйте файл в .env и заполните. Всё, что здесь есть, — техническая
# сторона стенда: она НЕ выводится в публичном интерфейсе сайта.
# Диагностика доступна оператору через GET /healthz и в админке.
#
# Значения по умолчанию (когда переменная не задана) указаны в скобках.

# ─── Основное ────────────────────────────────────────────────────────────────

# Production-домен. Используется в canonical, OG, sitemap, robots и JSON-LD —
# везде должен быть один и тот же адрес. (http://localhost:3000)
SITE_URL=https://example.kz

# Порт и интерфейс локального сервера. На Vercel задаёт платформа. (3000 / 127.0.0.1)
PORT=3000
HOST=127.0.0.1

# Таймзона расписания. В Казахстане с 2024 единый UTC+5. (Asia/Almaty)
SITE_TIMEZONE=Asia/Almaty

# Каталог базы (используется тестами и staging). (./data)
# DATA_DIR=

# ─── Админка ─────────────────────────────────────────────────────────────────

# ОБЯЗАТЕЛЬНО замените. Пока здесь стандартное значение-заглушка, на развёрнутом
# стенде админка закрыта полностью — и вход, и доступ по старой куке.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=dev-admin-token-change-me

# Пароль и секрет сессии (альтернатива токену), время жизни сессии в часах.
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=
# ADMIN_SESSION_TTL_HOURS=12

# ─── Уведомления ─────────────────────────────────────────────────────────────

# true — заявки сохраняются в базу, но бизнесу НЕ отправляются (по умолчанию).
# false — реальная отправка. Ставьте false только после проверки канала тестовой заявкой.
# В публичном интерфейсе режим не отображается.
MOCK_MODE=true

# Telegram — самый простой канал.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Webhook в CRM / n8n / Make: получает POST с JSON заявки.
# NOTIFY_WEBHOOK_URL=

# E-mail через HTTP-релей.
# NOTIFY_EMAIL_TO=
# NOTIFY_EMAIL_FROM=
# EMAIL_HTTP_ENDPOINT=
# EMAIL_HTTP_TOKEN=

# ─── Хранилище ───────────────────────────────────────────────────────────────

# Драйвер: file | kv | memory. По умолчанию выбирается автоматически.
# STORE_DRIVER=file

# Upstash Redis / Vercel KV. Файловая система на Vercel доступна только для
# чтения, а /tmp эфемерный — постоянное хранилище там возможно только через Redis.
# Интеграция добавляет переменные сама; имена Upstash тоже поддерживаются.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ─── Anti-spam и идемпотентность ─────────────────────────────────────────────

# Окно и лимит заявок с одного IP. (600000 мс / 8)
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=8

# Минимальное время заполнения формы: защита от ботов. (3)
FORM_MIN_FILL_SECONDS=3

# Сколько помним ключи повторных отправок. (15)
IDEMPOTENCY_WINDOW_MINUTES=15

# ─── Прочее ──────────────────────────────────────────────────────────────────

# 1 — отключить лог запросов.
# QUIET=

# VERCEL и VERCEL_URL проставляет сама платформа — задавать вручную не нужно.
