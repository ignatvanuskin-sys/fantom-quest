# ─────────────────────────────────────────────────────────────
# Fantom — конфигурация окружения
# Скопируйте файл в .env и заполните реальными значениями.
# ─────────────────────────────────────────────────────────────

# Публичный production-домен (используется в canonical, OG, sitemap, JSON-LD).
# ВАЖНО: один и тот же домен должен быть везде — canonical, OG, sitemap, robots.
SITE_URL=http://localhost:3000

PORT=3000
HOST=127.0.0.1

# Таймзона бизнеса. Казахстан с 2024 года — единый UTC+5.
SITE_TIMEZONE=Asia/Almaty

# ── Безопасность админки ─────────────────────────────────────
# ОБЯЗАТЕЛЬНО замените перед production. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=dev-admin-token-change-me

# ── Режим отправки заявок ────────────────────────────────────
# MOCK_MODE=true  → заявки НЕ уходят бизнесу, пишутся только в базу и в лог.
#                    На сайте и в админке висит явная плашка «mock / staging».
# MOCK_MODE=false → реальная отправка администратору по настроенным каналам ниже.
MOCK_MODE=true

# ── Каналы уведомлений администратора (MVP) ──────────────────
# Telegram Bot API: уведомление о новой заявке в чат/группу админов.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Универсальный webhook (CRM, n8n, Make, свой обработчик). POST JSON.
NOTIFY_WEBHOOK_URL=

# E-mail: без SMTP-зависимостей поддерживается HTTP-релей (Resend/SendGrid/Mailgun).
# Полный SMTP-транспорт — см. README, раздел «Уведомления».
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
EMAIL_HTTP_ENDPOINT=
EMAIL_HTTP_TOKEN=

# ── Anti-spam ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=8
# Минимальное время заполнения формы в секундах (honeypot-эвристика).
FORM_MIN_FILL_SECONDS=3
